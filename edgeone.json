{
  "cloudFunctions": {
    "mainlandRegions": [
      "ap-shanghai"
    ],
    "overseasRegions": [
      "ap-tokyo"
    ],
    "nodejs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/internal/live-post-shell/*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
