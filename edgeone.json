{
  "cloudFunctions": {
    "mainlandRegions": [
      "ap-shanghai"
    ],
    "overseasRegions": [
      "ap-tokyo"
    ],
    "nodejs": {
      "maxDuration": 30,
      "includeFiles": [
        "src/server/live-content/**"
      ]
    }
  },
  "headers": [
    {
      "source": "/_astro/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/internal/live-post-shell/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "buildCommand": "PUBLIC_GITHUB_ADMIN_BRANCH=master PUBLIC_FIREFLY_PREVIEW_DEMO=false pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "nodeVersion": "24.18.0"
}
