{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "firefly-blog-preview",
	"main": "./worker/blog-preview.ts",
	"compatibility_date": "2026-10-09",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/live-content/*", "/posts/*"]
	},
	"kv_namespaces": [
		{
			"binding": "LIVE_CONTENT_PREVIEW",
			"id": "5c0021d5e02241beaaa7d48f180c5239"
		}
	]
}
