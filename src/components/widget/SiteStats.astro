---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import { dynamicSlug } from "@/utils/dynamic-utils";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const [posts, dynamics] = await Promise.all([getSortedPosts(), getCollection("dynamic")]);
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];

		totalWords += chineseChars.length + englishChars.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 只包含公开内容的时间索引，不把后端构建/部署时间当作博客活动。
// 后台实时保存的文章、动态会在客户端通过公共 live-content index 覆盖此基线。
const activityBaseline = [
	...posts.filter((post) => !post.data.password).map((post) => ({
		kind: "post" as const,
		id: post.id.replace(/\.(?:md|mdx)$/i, ""),
		published: post.data.published.toISOString(),
		updated: post.data.updated?.toISOString() || null,
	})),
	...dynamics.map((dynamic) => ({
		kind: "dynamic" as const,
		id: dynamicSlug(dynamic.id),
		published: dynamic.data.published.toISOString(),
		updated: dynamic.data.updated?.toISOString() || null,
	})),
];
const todayText = i18n(I18nKey.today);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "mingcute:heartbeat-line",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div
    class="flex flex-col gap-2"
    data-site-stats-root
    data-activity-baseline={JSON.stringify(activityBaseline)}
    data-site-start-date={siteStartDate}
    data-activity-today={todayText}
  >
    {stats.map((stat) => (
      <div class="flex items-center justify-between px-3 py-1.5">
        <div class="flex items-center gap-2.5">
          <div class="text-(--primary) text-xl">
            <Icon name={stat.icon} />
          </div>
          <span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm">
            {stat.label}
          </span>
        </div>
        <div class="flex items-center">
          <span
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            data-stat-id={stat.id}
          >
            {stat.formatted ? formatNumber(stat.value) : stat.value}
          </span>
          {stat.suffix && (
            <span class="ml-1 text-sm text-neutral-500 dark:text-neutral-400">
              {stat.suffix}
            </span>
          )}
        </div>
      </div>
    ))}
  </div>
</WidgetLayout>

<script>
  import { lastPublicContentActivity, siteActivityTimestamp } from "@/utils/site-activity.js";

  type PublicActivityItem = {
    kind: "post" | "dynamic";
    id: string;
    published?: string | null;
    updated?: string | null;
  };
  type LiveActivityItem = {
    id: string;
    deleted?: boolean;
    hidden?: boolean;
    updatedAt?: string;
    meta?: { published?: string; updated?: string; draft?: boolean; protected?: boolean };
  };
  type StatsController = typeof window & {
    __fireflySiteStatsRefresh?: () => void;
  };
  const controller = window as StatsController;
  if (controller.__fireflySiteStatsRefresh) {
    // Swup might execute a page script twice: update without new listeners.
    controller.__fireflySiteStatsRefresh();
  } else {
    const cached: { post: LiveActivityItem[] | null; dynamic: LiveActivityItem[] | null } = {
      post: null,
      dynamic: null,
    };
    const DAY_MS = 86_400_000;
    let lastIndexFetch = 0;

    function render() {
      const now = Date.now();
      for (const block of document.querySelectorAll<HTMLElement>("[data-site-stats-root]")) {
        let baseline: PublicActivityItem[] = [];
        try {
          const parsed = JSON.parse(block.dataset.activityBaseline || "[]");
          if (Array.isArray(parsed)) baseline = parsed;
        } catch { /* render still works with available live data */ }

        const siteStart = siteActivityTimestamp(block.dataset.siteStartDate);
        const daysRunning = siteStart ? Math.max(0, Math.ceil((now - siteStart) / DAY_MS)) : 0;
        block.querySelectorAll<HTMLElement>('[data-stat-id="running-days"]')
          .forEach((item) => { item.textContent = String(daysRunning); });

        const latest = lastPublicContentActivity(baseline, cached, now);
        const elapsed = latest === null ? null : Math.max(0, Math.floor((now - latest) / DAY_MS));
        block.querySelectorAll<HTMLElement>('[data-stat-id="last-update"]')
          .forEach((element) => {
            const suffix = element.nextElementSibling as HTMLElement | null;
            if (elapsed === null) {
              element.textContent = "—";
              if (suffix) suffix.style.display = "none";
            } else if (elapsed === 0) {
              element.textContent = block.dataset.activityToday || "今天";
              if (suffix) suffix.style.display = "none";
            } else {
              element.textContent = String(elapsed);
              if (suffix) suffix.style.display = "";
            }
          });
      }
    }

    async function getPublicIndex(kind: "post" | "dynamic") {
      try {
        const response = await fetch(`/api/live-content/index?kind=${kind}`, { cache: "no-store" });
        if (!response.ok) return;
        const value: unknown = await response.json();
        if (!value || typeof value !== "object") return;
        const entries = (value as { entries?: unknown }).entries;
        if (Array.isArray(entries)) cached[kind] = entries as LiveActivityItem[];
      } catch {
        // No live store configured: keep the build-time article and dynamic baseline.
      }
    }

    async function refresh() {
      render(); // Fast initial paint, even before network index is available.
      if (Date.now() - lastIndexFetch < 90_000) return;
      lastIndexFetch = Date.now();
      await Promise.all([getPublicIndex("post"), getPublicIndex("dynamic")]);
      render();
    }
    controller.__fireflySiteStatsRefresh = () => { void refresh(); };
    document.addEventListener("swup:contentReplaced", () => {
      // Re-query current sidebar DOM (some layouts keep the sidebar mounted).
      setTimeout(() => { void refresh(); }, 100);
    });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) void refresh();
    });
    controller.__fireflySiteStatsRefresh();
  }
</script>
