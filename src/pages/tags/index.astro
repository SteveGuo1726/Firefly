---
import { getCollection } from "astro:content";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import LiveTaxonomy from "@/components/pages/post/LiveTaxonomy.svelte";
import { getTagList } from "@/utils/content-utils";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
const baseline = await getTagList();
const posts = await getCollection("posts", ({data}) => import.meta.env.PROD ? data.draft !== true : true);
const staticPosts = posts.map(p => ({ id:p.id, category:p.data.category || "", tags:p.data.tags || [] }));
const uncategorized = i18n(I18nKey.uncategorized);
---
<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
 <LiveTaxonomy client:load mode="tag" {baseline} {staticPosts} {uncategorized} />
</MainGridLayout>
